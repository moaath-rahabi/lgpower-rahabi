<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/channel_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Channel Number -->
    <TextView
        android:id="@+id/txt_channel_number"
        android:tag="row_label"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Channel Name, Shortcut & Source -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txt_channel_name"
                android:tag="row_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Channel Name"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txt_shortcut_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[#1]"
                android:textColor="#D4AF37"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/txt_channel_source"
                android:tag="row_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Satellite"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txt_live_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="LIVE"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_circle_green"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Star / Favorite button -->
    <ImageButton
        android:id="@+id/btn_channel_fav"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_star_outline"
        android:scaleType="center"
        android:contentDescription="Toggle Favorite" />

    <!-- 3-dot overflow menu -->
    <ImageButton
        android:id="@+id/btn_channel_menu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more_vert"
        android:scaleType="center"
        android:contentDescription="Channel Options" />
</LinearLayout>
